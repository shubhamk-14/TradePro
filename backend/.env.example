# Backend Environment Variables (.env)
SECRET_KEY=tradivora_super_secret_jwt_key_2026_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL (Defaults to SQLite if omitted; use PostgreSQL URL for Railway/Render)
DATABASE_URL=sqlite:///./tradivora.db

# CORS Origins (Comma-separated frontend domains)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://tradivora.vercel.app
