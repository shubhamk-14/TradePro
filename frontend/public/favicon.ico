<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="50%" stop-color="#14B8A6"/>
      <stop offset="100%" stop-color="#6366F1"/>
    </linearGradient>
    <linearGradient id="zapGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#ECFDF5"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.25"/>
    </filter>
  </defs>
  
  <!-- Outer Rounded Square Container -->
  <rect width="512" height="512" rx="140" fill="url(#bgGrad)"/>
  
  <!-- Inner White Card Background -->
  <rect x="32" y="32" width="448" height="448" rx="116" fill="#0F172A" opacity="0.15"/>
  
  <!-- Electric Zap Logo Icon -->
  <path d="M288 32L96 288h160l-32 192 192-256H256l32-224z" fill="url(#zapGrad)" filter="url(#shadow)"/>
</svg>
